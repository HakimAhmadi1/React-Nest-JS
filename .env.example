# Root-level configuration consumed by docker-compose.
# For local (non-Docker) development, use backend/.env and frontend/.env.

# REQUIRED — compose refuses to start without it.
# Generate with:  openssl rand -base64 48
JWT_SECRET=

# Database
DATABASE_NAME=app_db
DATABASE_USER=app_user
DATABASE_PASS=app_password
DATABASE_ROOT_PASSWORD=root_password
DATABASE_PORT_HOST=3307

# Published ports
API_PORT=3003
WEB_PORT=8080

# The frontend origin must appear in ALLOWED_ORIGINS or the browser blocks the
# API calls (and the refresh cookie never gets sent).
ALLOWED_ORIGINS=http://localhost:8080
APP_URL=http://localhost:8080
VITE_API_URL=http://localhost:3003/api

# Cookies: set both to secure/none only when the API and frontend are on
# genuinely different sites and served over HTTPS.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Seeding
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=
