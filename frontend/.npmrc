# `npm run build` runs Vite, which is a devDependency — a production-only
# install leaves the build with no bundler ("vite: not found").
#
# `include` takes precedence over `omit`, so this holds even when the host
# installs with NODE_ENV=production or --omit=dev.
#
# The frontend build output is static: once `dist/` exists, node_modules is
# dead weight on the server and can be deleted outright.
include=dev
