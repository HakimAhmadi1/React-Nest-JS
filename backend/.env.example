# ─── Server ──────────────────────────────────────────────────────────────
PORT=3003
NODE_ENV=development

# ─── Authentication ──────────────────────────────────────────────────────
# REQUIRED. Minimum 32 characters; the app refuses to boot with the
# placeholder value. Generate one with:  npm run jwtsecret -- --write
JWT_SECRET=replace_me_with_a_long_random_secret_at_least_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=fullstack-boilerplate
JWT_AUDIENCE=fullstack-boilerplate-client

# ─── Refresh-token cookie ────────────────────────────────────────────────
# localhost:5173 and localhost:3003 are the SAME site (ports are ignored for
# SameSite), so `lax` + insecure works in local development. For a genuinely
# cross-domain deployment use COOKIE_SAMESITE=none and COOKIE_SECURE=true.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# COOKIE_DOMAIN=.example.com

# ─── Database ────────────────────────────────────────────────────────────
# Schema is managed by migrations (`npm run migration:run`).
# There is no DATABASE_SYNC — setting it now fails the boot on purpose.
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_USER=root
DATABASE_PASS=password
DATABASE_NAME=app_db

# ─── HTTP ────────────────────────────────────────────────────────────────
# Comma-separated. Cannot be "*" — CORS credentials mode forbids a wildcard.
ALLOWED_ORIGINS=http://localhost:5173
# Public URL of the frontend; used to build password-reset links.
APP_URL=http://localhost:5173

# ─── Email (optional) ────────────────────────────────────────────────────
# With SMTP_HOST unset, emails are logged to the console instead of sent,
# so password reset works end-to-end on a fresh clone.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=user@example.com
# SMTP_PASS=your_smtp_password
# SMTP_FROM=no-reply@example.com

# ─── Cloudinary (optional) ───────────────────────────────────────────────
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# ─── Seeding ─────────────────────────────────────────────────────────────
# `npm run seed` refuses to run in production with the default password.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=Admin@123
