# The build needs devDependencies: `npm run build` runs `nest` (@nestjs/cli),
# `tsc` (typescript) and `tsc-alias`, none of which ship in the production
# dependency set. Managed hosts commonly install with NODE_ENV=production or
# --omit=dev and then run the build, which fails with "nest: command not found".
#
# `include` takes precedence over `omit`, so this survives both, and the build
# gets its toolchain without the deploy pipeline needing to be changed.
#
# The cost is that devDependencies stay installed on the server. Drop them
# after building, if your host lets you add a post-build step:
#
#     npm prune --omit=dev --include=prod
#
# Docker is unaffected: this file is in .dockerignore, so the image build still
# prunes to a production-only tree.
include=dev
